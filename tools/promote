#!/bin/bash
# Copies a team's winning implementation of a stage into pipeline/<stage>/.
#
#   tools/promote STAGE FORK SHA FOLDER
#
# FORK is the GitHub login that owns the team's fork, or a repository URL or
# path. SHA is the fork's commit at the time of the vote, and FOLDER the folder
# of that commit that holds the stage (day2/simulation, for example). The same
# SHA always gives the same files. Run it on a branch, not on main: it commits
# there, one commit per stage, for a single pull request of all the winners.
set -euo pipefail

[ $# -eq 4 ] || { sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//'; exit 2; }
stage=$1 fork=$2 sha=$3 folder=${4%/}

cd "$(git rev-parse --show-toplevel)"
branch=$(git rev-parse --abbrev-ref HEAD)
[ "$branch" != main ] || { echo "Run this on a branch, not on main." >&2; exit 1; }
[ -z "$(git status --porcelain)" ] || { echo "Commit or stash your changes first." >&2; exit 1; }
[ -d "stages/$stage" ] || { echo "No such stage: $stage (see stages/)." >&2; exit 1; }

case $fork in
*/* | *:*) url=$fork ;;
*) url=https://github.com/$fork/mritogetherthon-pipeline.git ;;
esac

git fetch -q "$url" "$sha" || { echo "Cannot fetch $sha from $url." >&2; exit 1; }
sha=$(git rev-parse FETCH_HEAD)
git cat-file -e "$sha:$folder" 2>/dev/null || { echo "$folder is not in commit $sha." >&2; exit 1; }

dest=pipeline/$stage
rm -rf "$dest"
mkdir -p "$dest"
depth=$(awk -F/ '{print NF}' <<<"$folder")
git archive "$sha" "$folder" | tar -x --strip-components="$depth" -C "$dest"

authors=$(git log --format='%an <%ae>' "$sha" -- "$folder" | sort -u)
{
    echo "# Source of $stage"
    echo
    echo "Copied from the fork $url"
    echo "at commit $sha, folder \`$folder\`, on $(date -u +%F)."
    echo
    echo "Authors:"
    sed 's/^/- /' <<<"$authors"
} > "$dest/SOURCE.md"

git add -A "$dest"
if git diff --cached --quiet; then
    echo "$dest is already up to date with $fork at ${sha:0:7}."
    exit 0
fi
{
    echo "Add the winning $stage, from $fork at ${sha:0:7}"
    echo
    sed 's/^/Co-authored-by: /' <<<"$authors"
} | git commit -q -F -
echo "$dest: $(git ls-files "$dest" | wc -l) files, from $fork at ${sha:0:7}."
